# Apenas exemplos locais. Não use credenciais reais.
POSTGRES_DB=oriontask
POSTGRES_USER=oriontask_local
POSTGRES_PASSWORD=change-me-local-only
# Gere um valor com pelo menos 32 bytes, por exemplo: openssl rand -base64 32
ORIONTASK_SESSION_HMAC_KEY=
# Lista opcional e separada por vírgulas de proxies confiáveis.
ORIONTASK_TRUSTED_PROXIES=
